PORT=5000
# Frontend URL allowed by CORS (use your Vercel URL in production)
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/rag-chat

# Vector DB (local: docker run -p 6333:6333 qdrant/qdrant | cloud: cloud.qdrant.io)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_documents

# LLM (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings: "gemini" (deployable, free tier) or "ollama" (local only)
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Retrieval
TOP_K=5
# Chunks below this cosine score are treated as irrelevant (0 to disable)
MIN_SCORE=0.35
