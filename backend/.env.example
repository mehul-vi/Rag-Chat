# Server Configuration
PORT=5000
# Allowed origins for CORS, comma-separated (e.g. http://localhost:5173 or https://your-domain.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Qdrant Vector Database
# Local: http://localhost:6333 | Cloud: https://xyz.qdrant.tech:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_documents

# Groq LLM (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (for embeddings and OCR fallback)
# https://aistudio.google.com/
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GEMINI_VISION_MODEL=gemini-2.5-flash
PDF_VISION_ENABLED=true

# Upload and Retrieval Settings
MAX_UPLOAD_MB=15
RAG_TOP_K=6
RAG_MIN_SCORE=0.25
